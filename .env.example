# Django
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=aihooshafza.ir,www.aihooshafza.ir,localhost,127.0.0.1

# Database
DB_NAME=hooshafza
DB_USER=hooshafza_user
DB_PASSWORD=hooshafza_password_change_this
DB_HOST=hooshafza-mysql
DB_PORT=3306
DB_ROOT_PASSWORD=hooshafza_root_password_change_this

# CORS
CORS_ALLOWED_ORIGINS=https://aihooshafza.ir,https://www.aihooshafza.ir

# JWT
JWT_SECRET_KEY=your-jwt-secret-change-this
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Payment Gateway
PAYMENT_GATEWAY=ZARINPAL
PAYMENT_API_KEY=your_payment_api_key
PAYMENT_MERCHANT_ID=your_merchant_id

# SpotPlayer
SPOTPLAYER_API_KEY=your_spotplayer_api_key
SPOTPLAYER_BASE_URL=https://panel.spotplayer.ir\nSPOTPLAYER_LICENSE_ENDPOINT=/license/edit/\nSPOTPLAYER_MODE=test\nSPOTPLAYER_DEVICE_LIMIT=2

# Site
SITE_DOMAIN=aihooshafza.ir
SITE_NAME=هوش افزا

# Infisical (secret delivery)
# Secrets are no longer read from a local .env file. They are injected at
# runtime by `infisical run`; the run scripts fetch them for you. See
# INFISICAL.md. These settings select the project and environment and should
# be provided as real environment variables, never committed:
#
#   INFISICAL_ENV=prod
#   INFISICAL_PROJECT_ID=your-project-id
#   INFISICAL_CLIENT_ID=your-machine-identity-client-id
#   INFISICAL_CLIENT_SECRET=your-machine-identity-client-secret
